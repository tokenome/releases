# Copy to .env and edit before `docker compose up`.

# Public (or internal) DNS name clients will use, e.g. tokenome.example.org.
# Caddy terminates TLS for this name (Let's Encrypt when publicly resolvable).
TOKENOME_DOMAIN=tokenome.example.org

# The server image version to run (a release tag from
# github.com/tokenome/releases, e.g. 0.5.3). Empty = latest.
TOKENOME_SERVER_VERSION=

# Shared secret between the server and Typesense. Generate a strong one:
#   openssl rand -hex 32
TYPESENSE_API_KEY=change-me-generate-a-long-random-key

# Optional: advertised via /v1/health so clients can prompt for updates.
LATEST_CLIENT_VERSION=
MIN_CLIENT_VERSION=

# Optional retention (spec §9): remove conversations older than N days
# (0 = keep forever); per-project overrides as name=days,name=days.
RETENTION_DAYS=0
RETENTION_PROJECTS=
